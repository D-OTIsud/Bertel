NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ENABLE_DEMO_MODE=false
NEXT_PUBLIC_MAP_STYLE_CLASSIC=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAP_STYLE_SATELLITE=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_MAP_STYLE_TOPO=https://tiles.openfreemap.org/styles/bright

# Server-side only. Used by the /api/media/upload route to write to the `media` bucket.
# DO NOT prefix with NEXT_PUBLIC_ — must never be sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only HMAC key. Keep stable across releases; an empty value
# preserves the service-role-key fallback for existing installations.
THESAURUS_CURSOR_SECRET=

# Server runtime only. Exact protocol-v1 opens manual list sends AFTER the SQL
# contract and homogeneous fleet are verified. Empty/unknown values stay closed.
# Notifications, invitations and Auth emails do not use this mode.
LIST_EMAIL_MODE=closed
